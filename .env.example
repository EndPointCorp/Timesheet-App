# Compose variables for the local dev stack (`make dev`).
# Copy to .env and start the local environment.
# Preview/production environments get their variables from Coolify instead.

DATABASE_PASSWORD=timesheet

# DATABASE_HOST=db
# DATABASE_PORT=5432
# DATABASE_NAME=timesheet
# DATABASE_USERNAME=timesheet

# Optional; dev falls back to a fixed insecure secret / host heuristics.
# SECRET_KEY_BASE=
# APP_HOST=
