#!/usr/bin/env rake
# Add your own tasks in files placed in lib/tasks ending in .rake,
# for example lib/tasks/capistrano.rake, and they will automatically be available to Rake.

require File.expand_path('../config/application', __FILE__)

TimesheetApp::Application.load_tasks
# do not drop database - instead, migrate it to state 0
Rake.application.instance_variable_get('@tasks').delete('db:test:purge')
Rake.application.instance_variable_get('@tasks').delete('db:test:prepare')
namespace :db do
  namespace :test do
    task :purge => [:environment] do

      ActiveRecord::Base.establish_connection(ActiveRecord::Base.configurations['test'])
      sql = ActiveRecord::Base.connection.execute %(select 'drop table if exists "' || tablename || '" cascade;' 
                                               from pg_tables
                                              where schemaname = 'public')
      ActiveRecord::Base.connection.execute sql.to_a.map { |i| i["?column?"] }.join("\n")
      sql_seqs = ActiveRecord::Base.connection.execute %(SELECT 'drop sequence if exists "' || relname || '" cascade;' 
                                              FROM pg_class c WHERE c.relkind = 'S';)
      
      ActiveRecord::Base.connection.execute sql_seqs.to_a.map { |i| i["?column?"] }.join("\n")
      sql_types = ActiveRecord::Base.connection.execute %(select 'drop type if exists "' || typname || '" cascade;' 
                                                          from pg_type 
                                                          where typowner = (select usesysid 
                                                              from pg_user where usename = 'timesheet') )
      ActiveRecord::Base.connection.execute sql_types.to_a.map { |i| i["?column?"] }.join("\n")
      ActiveRecord::Base.connection.execute "DROP SCHEMA IF EXISTS clean;"
      ActiveRecord::Base.connection.execute "DROP LANGUAGE IF EXISTS plpgsql CASCADE;"
    end

    task :prepare => [:environment, :purge] do
      ActiveRecord::Base.establish_connection(ActiveRecord::Base.configurations['test'])
      ActiveRecord::Migration.verbose = false
      ActiveRecord::Migrator.migrate("db/migrate/")
    end

    # Reproducible test-DB setup (see TEST_SUITE_NOTES.md). Drops & recreates the
    # isolated test DB, loads db/structure.sql, and populates the materialized
    # views the suite depends on. Loads schema through the pg connection rather
    # than shelling out to psql: the web image has no psql binary, and this
    # pg_dump-16 structure.sql uses \restrict meta-commands an older psql can't
    # parse. Run via `make test-db`.
    desc "Create the test DB, load db/structure.sql, and populate materialized views"
    task :setup => :environment do
      config = ActiveRecord::Base.configurations.fetch('test')
      db = config.fetch('database')
      # Guard against the dotenv footgun where the test env could resolve to the
      # dev DB; this task drops its target, so refuse anything not clearly a test DB.
      abort "Refusing: test database #{db.inspect} does not end in _test" unless db =~ /_test\z/

      ActiveRecord::Base.establish_connection(config.merge('database' => 'postgres'))
      ActiveRecord::Base.connection.drop_database(db) rescue nil
      ActiveRecord::Base.connection.create_database(db)

      ActiveRecord::Base.establish_connection(config)
      sql = File.read(Rails.root.join('db/structure.sql'))
              .each_line.reject { |l| l =~ /\A\\(un)?restrict\b/ }.join
      ActiveRecord::Base.connection.execute(sql)

      # structure.sql sets search_path to empty for the session, so qualify names.
      %w[chart_labels charts_search_specs project_summaries].each do |mv|
        ActiveRecord::Base.connection.execute("REFRESH MATERIALIZED VIEW public.#{mv}")
      end
      puts "Prepared test database #{db} (schema loaded, materialized views populated)."
    end
  end
end
