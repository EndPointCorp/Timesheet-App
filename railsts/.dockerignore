# Keeps `COPY . .` from pulling local state into the image.
# .env first: this directory has a real one, and configuration does not belong
# in a build artifact.

.env
.env.*
!.env.example

.git
.gitignore

# Runtime state, never useful in an image
log/
tmp/
coverage/
storage/
public/system/

# Local scratch
out.txt
.irbrc
*.swp
.DS_Store

# Docker's own files
Dockerfile
.dockerignore
