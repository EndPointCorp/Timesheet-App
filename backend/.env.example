# Copy this file to .env and adjust values for your local environment.
# .env is gitignored; never commit real secrets.

# --- Database ---------------------------------------------------------
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_NAME=timesheet
DATABASE_USERNAME=timesheet
DATABASE_PASSWORD=timesheet

# --- Secrets ----------------------------------------------------------
# Required in production (generate with `bin/rails secret`); dev/test fall
# back to a fixed insecure value when unset.
SECRET_KEY_BASE=

# Devise password pepper. MUST match the original production app's
# config.pepper for imported production password hashes to validate
# (find it in the production config/initializers/devise.rb). Leave empty
# for fresh/demo databases.
DEVISE_PEPPER=

# --- Public host ------------------------------------------------------
# FQDN used for mailer links and PDF asset URLs (e.g. timesheet.temphost.net).
# Unset locally: legacy camp/base-domain heuristics apply.
APP_HOST=

# --- Mailer -----------------------------------------------------------
MAILER_FROM_EMAIL=timesheet@example.com
MAILER_USER_REPORT_EMPTY_BCC_RECIPIENTS=
MAILER_USER_REPORT_FILLED_BCC_RECIPIENTS=

# SMTP relay. Defaults preserve the legacy localhost:25 behavior.
# MAILER_DELIVERY_METHOD=test disables real delivery (used by previews).
MAILER_DELIVERY_METHOD=
SMTP_ADDRESS=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=
SMTP_ENABLE_STARTTLS=

# --- App-specific constants -------------------------------------------
# Defaults match the synthetic demo seeds (db/seeds.rb). With a production
# dump restored from seeds/, use the ids from that data instead
# (2025 backup: WORK_CHART_CLIENTS_ID=3, TEAM_ROLE_ID=82).
WORK_CHART_ROOT_ID=1
WORK_CHART_CLIENTS_ID=2
TEAM_ROLE_ID=7
